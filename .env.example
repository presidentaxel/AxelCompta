# =============================================================================
# AxeLCompta — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer .env — seul .env.example va en git.
# =============================================================================

# -----------------------------------------------------------------------------
# Bridge (Bankin') — Open Banking / DSP2
# Obtenir les clés sur https://dashboard.bridgeapi.io
# -----------------------------------------------------------------------------
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=

# Environnement : sandbox | production
BRIDGE_ENV=sandbox

# URL de base — ne pas modifier sauf migration de version API
BRIDGE_BASE_URL=https://api.bridgeapi.io
BRIDGE_API_VERSION=2021-06-01

# -----------------------------------------------------------------------------
# Digifactory (canal bancaire pilote — doc 16)
# Token transmis hors bande par le fournisseur (Pierre BERTOLA), 64 caractères.
# -----------------------------------------------------------------------------
DIGIFACTORY_TOKEN=
DIGIFACTORY_BASE_URL=https://entrepreneur.digifactory.fr/api/bridge

# -----------------------------------------------------------------------------
# Base de données (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/axelcompta_dev

# -----------------------------------------------------------------------------
# Supabase Auth (comptes gestionnaire/chauffeur — doc 17 §9 bloc B)
# Décision du 2026-09-08 (voir docs/adr/ADR-003-hebergement.md, mise à
# jour du même jour) : Supabase Auth est retenu au-delà de la démo, y
# compris pour la V1 — ce n'est plus une exception à corriger.
# Auth seulement : DATABASE_URL ci-dessus reste la base applicative, pas
# celle du projet Supabase — décision du 2026-09-07, toujours valable.
# Clés dans le dashboard Supabase > Project Settings > API.
# SUPABASE_JWT_SECRET : gardée pour référence mais **plus utilisée** par
# axelcompta.demo_auth depuis le 2026-09-08 — ce projet signe ses jetons
# en ES256 via les « JWT Signing Keys » (JWKS, clé publique), pas en HS256
# avec un secret partagé. Seule SUPABASE_URL sert à la vérification (voir
# le commentaire de module de demo_auth.py).
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Stockage objet (MinIO local ou S3 en prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=axelcompta-dev

# -----------------------------------------------------------------------------
# ML — chemins des modèles (relatif ou absolu)
# -----------------------------------------------------------------------------
ML_MODEL_PATH=_AUDIT_DONNEES/modeles/tfidf_logreg_v1.joblib
